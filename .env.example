# PHP-PDNSManager Environment Configuration
APP_ENV=production
APP_DEBUG=false
APP_URL=https://your-domain.com
APP_TIMEZONE=UTC
APP_SECRET=64-char-hex-or-base64-key

DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pdnsmanager
DB_USERNAME=pdnsmanager
DB_PASSWORD=strong_password
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

PDNS_API_URL=http://127.0.0.1:8081
PDNS_API_KEY=your-api-key
PDNS_VERSION=4.9
PDNS_TIMEOUT=30
PDNS_VERIFY_SSL=true

SESSION_DRIVER=file
SESSION_LIFETIME=7200
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=strict

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=0

LOG_CHANNEL=stack
LOG_LEVEL=warning

SECURITY_CSP_ENABLED=true
SECURITY_RATE_LIMIT_ENABLED=true
SECURITY_RATE_LIMIT_REQUESTS=100
SECURITY_RATE_LIMIT_WINDOW=60
SECURITY_MFA_ENABLED=false

BACKUP_ENCRYPTION_KEY=64-char-hex-key
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE_PATH=/var/backups/php-pdnsmanager
