{
    "name": "alsyundawy/php-pdnsmanager",
    "description": "PHP PowerDNS Manager - Enterprise DNS Management",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "nyholm/psr7": "^1.8",
        "nyholm/psr7-server": "^1.1",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0",
        "guzzlehttp/guzzle": "^7.8",
        "monolog/monolog": "^3.5",
        "vlucas/phpdotenv": "^5.6",
        "ext-pdo": "*",
        "ext-json": "*",
        "ext-sodium": "*",
        "ext-curl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^1.11",
        "vimeo/psalm": "^5.24",
        "squizlabs/php_codesniffer": "^3.10",
        "rector/rector": "^1.2",
        "friendsofphp/php-cs-fixer": "^3.59"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Core/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --level=8",
        "psalm": "psalm",
        "cs": "phpcs --standard=PSR12",
        "cs-fix": "php-cs-fixer fix"
    }
}
